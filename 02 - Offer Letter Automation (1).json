    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Senior HR Manager at TechNova Solutions.\n\nGenerate a professional job offer letter for the following candidate.\n\nCandidate Name:\n{{$json[\"Full Name\"]}}\n\nCandidate Email:\n{{$json[\"Email\"]}}\n\nPosition:\n{{$json[\"Position\"]}}\n\nAI Score:\n{{$json[\"AI Score\"]}}\n\nSelection Decision:\n{{$json[\"Decision\"]}}\n\nJoining Date: 1 August 2026\nLocation: Bengaluru\nWork Mode: Hybrid\n\nInstructions:\n- Congratulate the candidate.\n- Mention that they have been selected.\n- Mention the position.\n- Mention the joining date.\n- Ask them to confirm within 5 working days.\n- End with a professional HR signature.\n\nIMPORTANT:\nUse the candidate details exactly as provided.\nDo NOT use placeholders like [Candidate Name], [Position], or [Candidate Email].\n\nReturn only the offer letter.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        464,
        -16
      ],
      "id": "7eaf523a-317a-4913-85ab-fa668a334aa7",
      "name": "AI Offer Letter Generator",
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "={{$node[\"Approved Candidate Trigger\"].json[\"Email\"]}}",
        "subject": "Congratulations! Your Offer Letter",
        "message": "=<p>Dear <strong>{{$node[\"Approved Candidate Trigger\"].json[\"Full Name\"]}}</strong>,</p>\n\n<p>\nCongratulations! 🎉\n</p>\n\n<p>\nWe are delighted to inform you that, based on your successful performance throughout our recruitment process, we are pleased to offer you the position of <strong>{{$node[\"Approved Candidate Trigger\"].json[\"Position\"]}}</strong> at <strong>ABC Technologies Pvt. Ltd.</strong>\n</p>\n\n<p>\nWe believe your skills and potential will be a valuable addition to our team, and we are excited to welcome you aboard.\n</p>\n\n<h3>Offer Details</h3>\n\n<ul>\n  <li><strong>Position:</strong> {{$node[\"Approved Candidate Trigger\"].json[\"Position\"]}}</li>\n  <li><strong>Joining Date:</strong> {{$node[\"Approved Candidate Trigger\"].json[\"Joining Date\"] || \"To Be Communicated\"}}</li>\n  <li><strong>Employment Type:</strong> Full-Time</li>\n  <li><strong>Work Mode:</strong> Hybrid / On-site</li>\n</ul>\n\n<p>\nYour official offer letter has been generated and is enclosed with this email (or will be shared shortly by our HR team).\n</p>\n\n<p>\nKindly confirm your acceptance by replying to this email within <strong>5 working days</strong>.\n</p>\n\n<p>\nIf you have any questions regarding the offer or joining process, please feel free to contact our HR department.\n</p>\n\n<p>\nWe look forward to working with you and wish you a successful career with our organization.\n</p>\n\n<br>\n\n<p>\nBest Regards,<br>\n<strong>HR Team</strong><br>\nABC Technologies Pvt. Ltd.\n</p>\n\n<hr>\n\n<p style=\"font-size:12px;color:gray;\">\nThis is an automated email generated by the AI Recruitment Automation System using n8n.\n</p>",
        "options": {}
      },
