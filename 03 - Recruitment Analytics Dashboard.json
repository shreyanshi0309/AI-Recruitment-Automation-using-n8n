    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst total = rows.length;\n\nconst shortlisted = rows.filter(\n  r => r.json.Status === \"Shortlist\"\n).length;\n\nconst rejected = rows.filter(\n  r => r.json.Status === \"Rejected\"\n).length;\n\nconst interviewScheduled = rows.filter(\n  r => r.json[\"Interview Date\"]\n).length;\n\nconst offerSent = rows.filter(\n  r => r.json[\"Offer Sent\"] === \"Yes\"\n).length;\n\nconst scores = rows\n  .map(r => Number(r.json[\"AI Score\"]))\n  .filter(n => !isNaN(n));\n\nconst average =\nscores.length\n? (scores.reduce((a,b)=>a+b,0)/scores.length).toFixed(2)\n: 0;\n\nreturn [{\njson:{\ntotal,\nshortlisted,\nrejected,\ninterviewScheduled,\nofferSent,\naverage\n}\n}];"
      },
